# Copia este archivo como .env y rellena tus valores.
# Nunca subas .env al repositorio (está en .gitignore).

# URL de tu proyecto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Publishable/anon key (NO la service_role)
EXPO_PUBLIC_SUPABASE_KEY=<tu-publishable-key>

# Necesario: Expo Router viene como dependencia transitiva de @expo/cli
# y bloquearía los imports de @react-navigation/*
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
